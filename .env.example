# Copy to .env and fill in. Get testnet creds at https://portal.hedera.com/dashboard
# .env is gitignored - never commit real keys.

# --- resource server (holds NO Hedera key; facilitator is fee-payer) ---
HEDERA_NETWORK=hedera:testnet
FACILITATOR_URL=https://api.testnet.blocky402.com
PAY_TO_ACCOUNT=0.0.xxxxxxx        # seller account id (receiver only, no key needed)
DATA_PROVIDER=mock
PORT=4021

# --- buyer / client (the only secret) ---
HEDERA_CLIENT_ID=0.0.yyyyyyy      # funded ECDSA testnet payer
HEDERA_CLIENT_KEY=0x...           # private key, read only by the signer process
SERVER_URL=http://localhost:4021
E2E_PRODUCT=spot-price
E2E_SYMBOL=AAPL

# --- AI buyer agent brain ---
LLM_PROVIDER=gemini               # gemini | anthropic
GEMINI_API_KEY=                   # free key: https://aistudio.google.com
GEMINI_MODEL=gemini-flash-latest
ANTHROPIC_API_KEY=                # optional; needs prepaid credits
